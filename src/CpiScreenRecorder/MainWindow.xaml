<Window x:Class="CpiScreenRecorder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CPI Screen Recorder"
        Width="1080" Height="720"
        MinWidth="980" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="#08111F"
        FontFamily="{StaticResource AppFont}"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>
        <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#126CFF" Offset="0"/>
            <GradientStop Color="#1B94FF" Offset="0.55"/>
            <GradientStop Color="#2CC7F5" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#101D34" Offset="0"/>
            <GradientStop Color="#0B1728" Offset="0.5"/>
            <GradientStop Color="#09111F" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="#111C2C"/>
            <Setter Property="BorderBrush" Value="#223651"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="FieldCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Foreground" Value="#F5F8FF"/>
            <Setter Property="Background" Value="#0D1726"/>
            <Setter Property="BorderBrush" Value="#2A4162"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FieldText" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Foreground" Value="#F5F8FF"/>
            <Setter Property="Background" Value="#0D1726"/>
            <Setter Property="BorderBrush" Value="#2A4162"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#2CC7F5"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Foreground" Value="#D9E7FB"/>
            <Setter Property="Background" Value="#18263A"/>
            <Setter Property="BorderBrush" Value="#2A4162"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#203451"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <Style x:Key="ToggleCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#DCE8F8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Track" Width="38" Height="22" CornerRadius="11"
                                    HorizontalAlignment="Left" Background="#32445D">
                                <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="#EAF3FF"
                                         HorizontalAlignment="Left" Margin="3,0,0,0"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="10,0,0,0"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#126CFF"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#263A57" BorderThickness="1" Background="#08111F">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#0A1423" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                    <Image Source="Resources/logo.png" Width="34" Height="34" Stretch="Uniform"/>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="CPI Screen Recorder" Foreground="#F7FAFF" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="CUTTING POINT INNOVATION" Foreground="#6683A8" FontSize="9" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button Style="{StaticResource WindowButton}" Content="—" Click="Minimize_Click"/>
                    <Button Style="{StaticResource WindowButton}" Content="✕" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource HeroGradient}" BorderBrush="#1B2D47" BorderThickness="0,0,1,0">
                    <Grid Margin="28,30,28,26">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Width="90" Height="90" CornerRadius="24" HorizontalAlignment="Left"
                                Background="#07111F" BorderBrush="#1E83FF" BorderThickness="1">
                            <Image Source="Resources/logo.png" Width="72" Height="72" Stretch="Uniform"/>
                        </Border>

                        <StackPanel Grid.Row="1" Margin="0,22,0,0">
                            <TextBlock Text="บันทึกหน้าจอ" FontSize="28" FontWeight="Bold" Foreground="#F7FAFF"/>
                            <TextBlock Text="สำหรับรีวิวระบบ คู่มือ และวิดีโอสาธิตของบริษัท"
                                       Margin="0,9,0,0" TextWrapping="Wrap" LineHeight="21"
                                       Foreground="#94A7C2" FontSize="13"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="0,30,0,0">
                            <Border Style="{StaticResource PanelCard}" Padding="16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#38D996" Margin="0,0,9,0"/>
                                        <TextBlock x:Name="StatusText" Text="พร้อมบันทึก" Foreground="#DFF8EE" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TimerText" Text="00:00:00" Margin="0,13,0,0"
                                               FontSize="34" FontWeight="SemiBold" Foreground="#F7FAFF"/>
                                    <TextBlock Text="High-fidelity SDR · H.264 High"
                                               Margin="0,8,0,0" Foreground="#6F8FB7" FontSize="11"/>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,14,0,0" Background="#0B1A2D" CornerRadius="14" Padding="14" BorderBrush="#17385D" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="COLOR SAFE" Foreground="#29C3F2" FontWeight="Bold" FontSize="10"/>
                                    <TextBlock Margin="0,7,0,0" Text="ตั้งค่าเริ่มต้นเน้นความคมชัดและสี UI สำหรับการทำคู่มือ โดยไม่ย่อความละเอียดของจอ"
                                               Foreground="#8FA6C5" FontSize="11" TextWrapping="Wrap" LineHeight="18"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="3">
                            <TextBlock Text="ไฟล์ล่าสุด" Foreground="#6F84A3" FontSize="10" FontWeight="SemiBold"/>
                            <TextBlock x:Name="LatestFileText" Text="ยังไม่มีไฟล์บันทึก" Foreground="#C2D0E4" FontSize="11"
                                       TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="OpenFileButton" Style="{StaticResource SecondaryButton}" Height="34" Padding="12,0"
                                        Content="เปิดไฟล์" IsEnabled="False" Click="OpenFile_Click"/>
                                <Button x:Name="OpenFolderButton" Style="{StaticResource SecondaryButton}" Height="34" Padding="12,0"
                                        Margin="8,0,0,0" Content="เปิดโฟลเดอร์" IsEnabled="False" Click="OpenFolder_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="32,28,32,28" MaxWidth="700">
                        <TextBlock Text="ตั้งค่าการบันทึก" Foreground="#F7FAFF" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="เลือกหน้าจอและเริ่มบันทึกได้ทันที ไฟล์จะถูกบันทึกเป็น MP4"
                                   Foreground="#8499B7" FontSize="12" Margin="0,6,0,22"/>

                        <Border Style="{StaticResource PanelCard}">
                            <StackPanel>
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="หน้าจอที่ต้องการบันทึก" Foreground="#E5EEFA" FontWeight="SemiBold" FontSize="13"/>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Height="30" Padding="11,0"
                                            Content="รีเฟรช" Click="RefreshDisplays_Click"/>
                                </DockPanel>
                                <ComboBox x:Name="DisplayCombo" Style="{StaticResource FieldCombo}" Margin="0,12,0,0"
                                          DisplayMemberPath="Label"/>
                                <TextBlock Text="บันทึกตามความละเอียดจริงของจอที่เลือก" Foreground="#617A9C" FontSize="10" Margin="2,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource PanelCard}">
                                <StackPanel>
                                    <TextBlock Text="Frame rate" Foreground="#E5EEFA" FontWeight="SemiBold" FontSize="13"/>
                                    <ComboBox x:Name="FpsCombo" Style="{StaticResource FieldCombo}" Margin="0,12,0,0">
                                        <ComboBoxItem Content="30 FPS · แนะนำ" Tag="30" IsSelected="True"/>
                                        <ComboBoxItem Content="60 FPS · ลื่นไหล" Tag="60"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource PanelCard}">
                                <StackPanel>
                                    <TextBlock Text="คุณภาพวิดีโอ" Foreground="#E5EEFA" FontWeight="SemiBold" FontSize="13"/>
                                    <Border Margin="0,12,0,0" Height="42" CornerRadius="10" Background="#0D1726" BorderBrush="#2A4162" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                                            <Ellipse Width="8" Height="8" Fill="#2CC7F5"/>
                                            <TextBlock Text="High Fidelity" Foreground="#F2F7FF" Margin="8,0,0,0" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource PanelCard}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="เมาส์และไฮไลต์" Foreground="#E5EEFA" FontWeight="SemiBold" FontSize="13"/>
                                <CheckBox x:Name="CursorCheck" Style="{StaticResource ToggleCheck}" Margin="0,15,0,0" IsChecked="True"
                                          Content="แสดงตำแหน่งเมาส์ในวิดีโอ"/>
                                <CheckBox x:Name="ClickHighlightCheck" Style="{StaticResource ToggleCheck}" Margin="0,13,0,0" IsChecked="True"
                                          Content="ไฮไลต์ตำแหน่งเมื่อคลิก เพื่อทำคู่มือดูง่ายขึ้น"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PanelCard}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="ตำแหน่งบันทึกไฟล์" Foreground="#E5EEFA" FontWeight="SemiBold" FontSize="13"/>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="OutputPathText" Grid.Column="0" Style="{StaticResource FieldText}" IsReadOnly="True"/>
                                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="เลือกโฟลเดอร์" Click="BrowseOutput_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="StartButton" Grid.Column="0" Height="58" Cursor="Hand" Foreground="White"
                                    FontWeight="Bold" FontSize="15" Click="StartRecording_Click" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Root" Background="{StaticResource BrandGradient}" CornerRadius="14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="13" Height="13" Fill="White" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <ContentPresenter Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Opacity" Value="0.92"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Root" Property="Opacity" Value="0.38"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="เริ่มบันทึกหน้าจอ"/>
                            </Button>

                            <Button x:Name="StopButton" Grid.Column="2" Style="{StaticResource SecondaryButton}" Height="58"
                                    FontWeight="SemiBold" FontSize="14" Content="■  หยุดบันทึก" IsEnabled="False" Click="StopRecording_Click"/>
                        </Grid>

                        <TextBlock Text="CPI Screen Recorder v0.1 · บันทึกในเครื่องเท่านั้น · ไม่มีการอัปโหลดไฟล์ขึ้นอินเทอร์เน็ต"
                                   Foreground="#506A8D" FontSize="10" Margin="2,14,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
