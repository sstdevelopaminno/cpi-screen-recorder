<Window x:Class="CpiScreenRecorder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="CPI Screen Recorder"
        Icon="Resources/AppIcon.ico"
        Width="1040" Height="680"
        MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#07111F"
        FontFamily="{StaticResource AppFont}"
        Loaded="Window_Loaded"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="8"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#126CFF" Offset="0"/>
            <GradientStop Color="#1698FF" Offset="0.55"/>
            <GradientStop Color="#2CC7F5" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0D1A2D" Offset="0"/>
            <GradientStop Color="#091523" Offset="0.55"/>
            <GradientStop Color="#07111F" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="#101C2C"/>
            <Setter Property="BorderBrush" Value="#29405E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#EDF5FF"/>
            <Setter Property="Background" Value="#0D1726"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#183A5D"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#15528B"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#7F92AA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboItem}"/>

        <Style x:Key="FieldComboItem" TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="#EAF2FF"/>
            <Setter Property="Background" Value="#0D1726"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                VerticalAlignment="Center"
                                HorizontalAlignment="Stretch"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#173659"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1459A6"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#0B1524"/>
                                <Setter Property="Foreground" Value="#91A5C0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldCombo" TargetType="{x:Type ComboBox}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Foreground" Value="#F7FAFF"/>
            <Setter Property="Background" Value="#0D1726"/>
            <Setter Property="BorderBrush" Value="#315173"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource FieldComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <Border x:Name="Root"
                                    Height="{TemplateBinding Height}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"/>
                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <Grid>
                                    <ContentPresenter
                                        Margin="12,0,42,0"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left"
                                        Content="{TemplateBinding SelectionBoxItem}"
                                        ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                        TextElement.Foreground="{TemplateBinding Foreground}"/>
                                    <Border Width="32" HorizontalAlignment="Right" Background="#13243A" CornerRadius="0,9,9,0">
                                        <TextBlock Text="⌄" Foreground="#BFD2EA" FontSize="15"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Width="{Binding ActualWidth, ElementName=Root}"
                                        Margin="0,4,0,0"
                                        Background="#0A1422"
                                        BorderBrush="#315173"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <ScrollViewer MaxHeight="280"
                                                  CanContentScroll="True"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#2AAEFF"/>
                                <Setter TargetName="Root" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#3F6D9B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#A9BAD0"/>
                                <Setter TargetName="Root" Property="Background" Value="#0B1524"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#263B55"/>
                                <Setter TargetName="DropDownToggle" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldText" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Foreground" Value="#F5F9FF"/>
            <Setter Property="Background" Value="#0B1727"/>
            <Setter Property="BorderBrush" Value="#355273"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#2CC7F5"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Foreground" Value="#E4EEFA"/>
            <Setter Property="Background" Value="#17283D"/>
            <Setter Property="BorderBrush" Value="#365473"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#203B59"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#3C6C98"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#10253A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#70839C"/>
                                <Setter TargetName="Root" Property="Background" Value="#101A28"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#22334A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="CloseWindowButton" TargetType="Button" BasedOn="{StaticResource WindowButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C42B3D"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToggleCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#DCE8F8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Track"
                                    Width="38" Height="22"
                                    CornerRadius="11"
                                    HorizontalAlignment="Left"
                                    Background="#344960">
                                <Ellipse x:Name="Thumb"
                                         Width="16" Height="16"
                                         Fill="#F3F7FC"
                                         HorizontalAlignment="Left"
                                         Margin="3,0,0,0"/>
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              Margin="10,0,0,0"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#167BFF"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#788DA7"/>
                                <Setter TargetName="Track" Property="Background" Value="#26364A"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#8293A8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptureModeRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#E4EEFA"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="58"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ModeBorder"
                                Background="#0B1727"
                                BorderBrush="#2D4868"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12,9">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ModeBorder" Property="Background" Value="#122943"/>
                                <Setter TargetName="ModeBorder" Property="BorderBrush" Value="#37688F"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ModeBorder" Property="Background" Value="#0F3157"/>
                                <Setter TargetName="ModeBorder" Property="BorderBrush" Value="#2CAEFF"/>
                                <Setter TargetName="ModeBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#71849C"/>
                                <Setter TargetName="ModeBorder" Property="Background" Value="#111A27"/>
                                <Setter TargetName="ModeBorder" Property="BorderBrush" Value="#22344A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="#07111F"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Opacity="0"
                                                  Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#355574"
                                                        CornerRadius="5"
                                                        Margin="2,1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Opacity="0"
                                                  Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="#2CC7F5"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#253A56"
            BorderThickness="1"
            Background="#07111F">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Background="#091524"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="14,0">
                    <Image Source="Resources/logo.png"
                           Width="30" Height="30"
                           Stretch="Uniform"/>
                    <StackPanel Margin="9,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="CPI Screen Recorder"
                                   Foreground="#F7FAFF"
                                   FontWeight="SemiBold"
                                   FontSize="13"/>
                        <TextBlock Text="CUTTING POINT INNOVATION"
                                   Foreground="#6282A8"
                                   FontSize="8.5"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,6,0">
                    <Button Style="{StaticResource WindowButton}"
                            Content="—"
                            ToolTip="ย่อหน้าต่าง"
                            Click="Minimize_Click"/>
                    <Button x:Name="MaximizeButton"
                            Style="{StaticResource WindowButton}"
                            Content="□"
                            ToolTip="ขยายเต็มจอ / คืนขนาด"
                            Click="MaximizeRestore_Click"/>
                    <Button Style="{StaticResource CloseWindowButton}"
                            Content="✕"
                            ToolTip="ปิดโปรแกรม"
                            Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{StaticResource HeroGradient}"
                        BorderBrush="#1E324B"
                        BorderThickness="0,0,1,0">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="22,22,22,20">
                            <Border Width="72" Height="72"
                                    CornerRadius="19"
                                    HorizontalAlignment="Left"
                                    Background="#07111F"
                                    BorderBrush="#1E83FF"
                                    BorderThickness="1">
                                <Image Source="Resources/logo.png"
                                       Width="58" Height="58"
                                       Stretch="Uniform"/>
                            </Border>

                            <TextBlock Text="บันทึกหน้าจอ"
                                       Margin="0,18,0,0"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#F7FAFF"/>
                            <TextBlock Text="รีวิวระบบ คู่มือ และวิดีโอสาธิต พร้อมเสียงไมค์และเสียงจากคอม"
                                       Margin="0,7,0,0"
                                       TextWrapping="Wrap"
                                       LineHeight="19"
                                       Foreground="#94A7C2"
                                       FontSize="11.5"/>

                            <Border Style="{StaticResource PanelCard}"
                                    Margin="0,22,0,0"
                                    Padding="14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="StatusDot"
                                                 Width="8" Height="8"
                                                 Fill="#38D996"
                                                 Margin="0,0,8,0"/>
                                        <TextBlock x:Name="StatusText"
                                                   Text="พร้อมบันทึก"
                                                   Foreground="#E7F7F0"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TimerText"
                                               Text="00:00:00"
                                               Margin="0,11,0,0"
                                               FontSize="30"
                                               FontWeight="SemiBold"
                                               Foreground="#FFFFFF"/>
                                    <TextBlock Text="High-fidelity SDR · H.264 High"
                                               Margin="0,6,0,0"
                                               Foreground="#7396C0"
                                               FontSize="10"/>
                                    <TextBlock x:Name="AudioSummaryText"
                                               Text="เสียง: ปิด"
                                               Margin="0,4,0,0"
                                               Foreground="#7396C0"
                                               FontSize="10"/>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,12,0,0"
                                    Background="#0A1A2D"
                                    CornerRadius="12"
                                    Padding="12"
                                    BorderBrush="#174A73"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="CAPTURE MODES"
                                               Foreground="#32C7F4"
                                               FontWeight="Bold"
                                               FontSize="9"/>
                                    <TextBlock Margin="0,5,0,0"
                                               Text="เต็มจอ · โปรแกรม · เลือกพื้นที่ รองรับหลาย Monitor"
                                               Foreground="#9CB0C9"
                                               FontSize="10"
                                               TextWrapping="Wrap"
                                               LineHeight="16"/>
                                </StackPanel>
                            </Border>

                            <Border Height="1"
                                    Background="#1B2E45"
                                    Margin="0,20,0,16"/>

                            <TextBlock Text="ไฟล์ล่าสุด"
                                       Foreground="#7188A7"
                                       FontSize="9.5"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="LatestFileText"
                                       Text="ยังไม่มีไฟล์บันทึก"
                                       Foreground="#C9D6E8"
                                       FontSize="10.5"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,5,0,0"/>

                            <WrapPanel Margin="0,10,0,0">
                                <Button x:Name="OpenFileButton"
                                        Style="{StaticResource SecondaryButton}"
                                        Height="32"
                                        Padding="10,0"
                                        Content="เปิดไฟล์"
                                        IsEnabled="False"
                                        Click="OpenFile_Click"/>
                                <Button x:Name="OpenFolderButton"
                                        Style="{StaticResource SecondaryButton}"
                                        Height="32"
                                        Padding="10,0"
                                        Margin="7,0,0,0"
                                        Content="เปิดโฟลเดอร์"
                                        IsEnabled="False"
                                        Click="OpenFolder_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="86"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar"
                                   BasedOn="{StaticResource DarkScrollBar}"/>
                        </ScrollViewer.Resources>

                        <StackPanel Margin="24,20,24,18">
                            <TextBlock Text="ตั้งค่าการบันทึก"
                                       Foreground="#F7FAFF"
                                       FontSize="20"
                                       FontWeight="Bold"/>
                            <TextBlock Text="เลือกพื้นที่ ภาพ เสียง และตำแหน่งไฟล์ก่อนเริ่มบันทึก"
                                       Foreground="#8EA4C1"
                                       FontSize="11"
                                       Margin="0,5,0,16"/>

                            <Border x:Name="ModePanel"
                                    Style="{StaticResource PanelCard}">
                                <StackPanel>
                                    <TextBlock Text="โหมดการบันทึก"
                                               Foreground="#EEF5FF"
                                               FontWeight="SemiBold"
                                               FontSize="12"/>
                                    <Grid Margin="0,11,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <RadioButton x:Name="ModeDisplayRadio"
                                                     Grid.Column="0"
                                                     Style="{StaticResource CaptureModeRadio}"
                                                     GroupName="CaptureMode"
                                                     Checked="CaptureMode_Checked">
                                            <StackPanel>
                                                <TextBlock Text="เต็มจอ"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="เลือก Monitor"
                                                           Foreground="#89A0BD"
                                                           FontSize="9.5"
                                                           Margin="0,3,0,0"
                                                           HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>

                                        <RadioButton x:Name="ModeWindowRadio"
                                                     Grid.Column="2"
                                                     Style="{StaticResource CaptureModeRadio}"
                                                     GroupName="CaptureMode"
                                                     Checked="CaptureMode_Checked">
                                            <StackPanel>
                                                <TextBlock Text="เฉพาะโปรแกรม"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="เลือก Window"
                                                           Foreground="#89A0BD"
                                                           FontSize="9.5"
                                                           Margin="0,3,0,0"
                                                           HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>

                                        <RadioButton x:Name="ModeRegionRadio"
                                                     Grid.Column="4"
                                                     Style="{StaticResource CaptureModeRadio}"
                                                     GroupName="CaptureMode"
                                                     Checked="CaptureMode_Checked">
                                            <StackPanel>
                                                <TextBlock Text="เลือกพื้นที่"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="ลากกรอบเอง"
                                                           Foreground="#89A0BD"
                                                           FontSize="9.5"
                                                           Margin="0,3,0,0"
                                                           HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border x:Name="DisplayCard"
                                    Style="{StaticResource PanelCard}"
                                    Margin="0,12,0,0">
                                <StackPanel>
                                    <DockPanel LastChildFill="True">
                                        <TextBlock Text="หน้าจอ / Monitor"
                                                   Foreground="#EEF5FF"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"/>
                                        <Button DockPanel.Dock="Right"
                                                Style="{StaticResource SecondaryButton}"
                                                Height="30"
                                                Padding="10,0"
                                                Content="รีเฟรช"
                                                Click="RefreshDisplays_Click"/>
                                    </DockPanel>

                                    <ComboBox x:Name="DisplayCombo"
                                              Style="{StaticResource FieldCombo}"
                                              Margin="0,10,0,0"
                                              DisplayMemberPath="Label"
                                              SelectionChanged="DisplayCombo_SelectionChanged"/>

                                    <TextBlock Text="ถ้ามีหลายจอ ระบบจะแสดง DISPLAY1 / DISPLAY2 พร้อมความละเอียดของแต่ละจอ"
                                               Foreground="#6F87A6"
                                               FontSize="9.5"
                                               Margin="2,7,0,0"
                                               TextWrapping="Wrap"/>

                                    <StackPanel x:Name="RegionControls"
                                                Margin="0,12,0,0"
                                                Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
                                                    Height="40"
                                                    CornerRadius="10"
                                                    Background="#0B1727"
                                                    BorderBrush="#355273"
                                                    BorderThickness="1">
                                                <TextBlock x:Name="RegionLabel"
                                                           Text="ยังไม่ได้เลือกพื้นที่"
                                                           Foreground="#D9E7FB"
                                                           VerticalAlignment="Center"
                                                           Margin="12,0"/>
                                            </Border>
                                            <Button Grid.Column="2"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Content="ลากกรอบเลือกพื้นที่"
                                                    Click="SelectRegion_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border x:Name="WindowCard"
                                    Style="{StaticResource PanelCard}"
                                    Margin="0,12,0,0"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <DockPanel LastChildFill="True">
                                        <TextBlock Text="หน้าต่างโปรแกรม"
                                                   Foreground="#EEF5FF"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"/>
                                        <Button DockPanel.Dock="Right"
                                                Style="{StaticResource SecondaryButton}"
                                                Height="30"
                                                Padding="10,0"
                                                Content="รีเฟรช"
                                                Click="RefreshWindows_Click"/>
                                    </DockPanel>

                                    <ComboBox x:Name="WindowCombo"
                                              Style="{StaticResource FieldCombo}"
                                              Margin="0,10,0,0"
                                              DisplayMemberPath="Label"/>

                                    <TextBlock Text="บันทึกเฉพาะหน้าต่างที่เลือก เช่น CpiPOS หรือ Browser โดยไม่ติด Desktop รอบข้าง"
                                               Foreground="#6F87A6"
                                               FontSize="9.5"
                                               Margin="2,7,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Grid x:Name="VideoOptionsPanel"
                                  Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Style="{StaticResource PanelCard}">
                                    <StackPanel>
                                        <TextBlock Text="Frame rate"
                                                   Foreground="#EEF5FF"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"/>
                                        <ComboBox x:Name="FpsCombo"
                                                  Style="{StaticResource FieldCombo}"
                                                  Margin="0,10,0,0">
                                            <ComboBoxItem Content="30 FPS · แนะนำ"
                                                          Tag="30"
                                                          IsSelected="True"/>
                                            <ComboBoxItem Content="60 FPS · ลื่นไหล"
                                                          Tag="60"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        Style="{StaticResource PanelCard}">
                                    <StackPanel>
                                        <TextBlock Text="คุณภาพวิดีโอ"
                                                   Foreground="#EEF5FF"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"/>
                                        <Border Margin="0,10,0,0"
                                                Height="42"
                                                CornerRadius="10"
                                                Background="#0B1727"
                                                BorderBrush="#355273"
                                                BorderThickness="1">
                                            <StackPanel Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        Margin="12,0">
                                                <Ellipse Width="8"
                                                         Height="8"
                                                         Fill="#2CC7F5"/>
                                                <TextBlock Text="High Fidelity · H.264"
                                                           Foreground="#F4F8FF"
                                                           Margin="8,0,0,0"
                                                           FontWeight="SemiBold"
                                                           FontSize="11"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border x:Name="MousePanel"
                                    Style="{StaticResource PanelCard}"
                                    Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="เมาส์และไฮไลต์"
                                               Foreground="#EEF5FF"
                                               FontWeight="SemiBold"
                                               FontSize="12"/>
                                    <CheckBox x:Name="CursorCheck"
                                              Style="{StaticResource ToggleCheck}"
                                              Margin="0,13,0,0"
                                              IsChecked="True"
                                              Content="แสดงตำแหน่งเมาส์ในวิดีโอ"/>
                                    <CheckBox x:Name="ClickHighlightCheck"
                                              Style="{StaticResource ToggleCheck}"
                                              Margin="0,11,0,0"
                                              IsChecked="True"
                                              Content="ไฮไลต์ตำแหน่งเมื่อคลิก เพื่อทำคู่มือดูง่ายขึ้น"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="AudioPanel"
                                    Style="{StaticResource PanelCard}"
                                    Margin="0,12,0,0">
                                <StackPanel>
                                    <DockPanel LastChildFill="True">
                                        <StackPanel>
                                            <TextBlock Text="เสียง"
                                                       Foreground="#EEF5FF"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"/>
                                            <TextBlock Text="เลือกไมค์ เสียงในคอม หรือเปิดพร้อมกันได้"
                                                       Foreground="#6F87A6"
                                                       FontSize="9.5"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Button DockPanel.Dock="Right"
                                                Style="{StaticResource SecondaryButton}"
                                                Height="30"
                                                Padding="10,0"
                                                Content="รีเฟรชอุปกรณ์เสียง"
                                                Click="RefreshAudio_Click"/>
                                    </DockPanel>

                                    <Border Margin="0,12,0,0"
                                            Background="#0B1727"
                                            BorderBrush="#2B4564"
                                            BorderThickness="1"
                                            CornerRadius="11"
                                            Padding="12">
                                        <StackPanel>
                                            <CheckBox x:Name="MicrophoneCheck"
                                                      Style="{StaticResource ToggleCheck}"
                                                      Content="บันทึกเสียงไมโครโฟน"
                                                      Checked="AudioOption_Changed"
                                                      Unchecked="AudioOption_Changed"/>
                                            <Grid x:Name="MicrophoneControls"
                                                  Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <ComboBox x:Name="MicrophoneCombo"
                                                          Grid.Column="0"
                                                          Style="{StaticResource FieldCombo}"
                                                          DisplayMemberPath="Label"/>

                                                <StackPanel Grid.Column="2"
                                                            VerticalAlignment="Center">
                                                    <TextBlock x:Name="MicrophoneVolumeText"
                                                               Text="ระดับไมค์ 100%"
                                                               Foreground="#A8BAD0"
                                                               FontSize="9.5"/>
                                                    <Slider x:Name="MicrophoneVolumeSlider"
                                                            Minimum="0"
                                                            Maximum="100"
                                                            Value="100"
                                                            Margin="0,6,0,0"
                                                            ValueChanged="MicrophoneVolumeSlider_ValueChanged"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Margin="0,9,0,0"
                                            Background="#0B1727"
                                            BorderBrush="#2B4564"
                                            BorderThickness="1"
                                            CornerRadius="11"
                                            Padding="12">
                                        <StackPanel>
                                            <CheckBox x:Name="SystemAudioCheck"
                                                      Style="{StaticResource ToggleCheck}"
                                                      Content="บันทึกเสียงในคอมพิวเตอร์ (เพลง / Browser / โปรแกรม)"
                                                      Checked="AudioOption_Changed"
                                                      Unchecked="AudioOption_Changed"/>
                                            <Grid x:Name="SystemAudioControls"
                                                  Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <ComboBox x:Name="SystemAudioCombo"
                                                          Grid.Column="0"
                                                          Style="{StaticResource FieldCombo}"
                                                          DisplayMemberPath="Label"/>

                                                <StackPanel Grid.Column="2"
                                                            VerticalAlignment="Center">
                                                    <TextBlock x:Name="SystemAudioVolumeText"
                                                               Text="ระดับเสียงคอม 100%"
                                                               Foreground="#A8BAD0"
                                                               FontSize="9.5"/>
                                                    <Slider x:Name="SystemAudioVolumeSlider"
                                                            Minimum="0"
                                                            Maximum="100"
                                                            Value="100"
                                                            Margin="0,6,0,0"
                                                            ValueChanged="SystemAudioVolumeSlider_ValueChanged"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border x:Name="OutputPanel"
                                    Style="{StaticResource PanelCard}"
                                    Margin="0,12,0,8">
                                <StackPanel>
                                    <TextBlock Text="ตำแหน่งบันทึกไฟล์"
                                               Foreground="#EEF5FF"
                                               FontWeight="SemiBold"
                                               FontSize="12"/>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox x:Name="OutputPathText"
                                                 Grid.Column="0"
                                                 Style="{StaticResource FieldText}"
                                                 IsReadOnly="True"/>

                                        <Button Grid.Column="2"
                                                Style="{StaticResource SecondaryButton}"
                                                Content="เลือกโฟลเดอร์"
                                                Click="BrowseOutput_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="1"
                            Background="#0A1626"
                            BorderBrush="#213751"
                            BorderThickness="0,1,0,0"
                            Padding="20,13">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="StartButton"
                                    Grid.Column="0"
                                    Height="56"
                                    Cursor="Hand"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    FontSize="14"
                                    Click="StartRecording_Click"
                                    BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Root"
                                                Background="{StaticResource BrandGradient}"
                                                CornerRadius="13">
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <Ellipse Width="11"
                                                         Height="11"
                                                         Fill="White"
                                                         Margin="0,0,9,0"/>
                                                <ContentPresenter/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Opacity" Value="0.93"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Root" Property="Opacity" Value="0.82"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Root" Property="Background" Value="#163047"/>
                                                <Setter Property="Foreground" Value="#7290AA"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="เริ่มบันทึกหน้าจอ"/>
                            </Button>

                            <Button x:Name="StopButton"
                                    Grid.Column="2"
                                    Height="56"
                                    Padding="14,0"
                                    Foreground="#FFFFFF"
                                    Background="#4B2130"
                                    BorderBrush="#A3425C"
                                    BorderThickness="1"
                                    FontWeight="SemiBold"
                                    FontSize="13"
                                    Content="■  หยุดบันทึก"
                                    IsEnabled="False"
                                    Click="StopRecording_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Root"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="13">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="#6A2940"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Root" Property="Background" Value="#111D2B"/>
                                                <Setter TargetName="Root" Property="BorderBrush" Value="#23354B"/>
                                                <Setter Property="Foreground" Value="#6E829B"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
            <ResizeGrip Grid.RowSpan="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Width="18" Height="18"
                        Margin="0,0,3,3"
                        Foreground="#4D6A8F"
                        Background="Transparent"/>
        </Grid>
    </Border>
</Window>
