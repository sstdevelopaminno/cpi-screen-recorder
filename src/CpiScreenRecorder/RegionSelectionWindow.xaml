<Window x:Class="CpiScreenRecorder.RegionSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="#66030B16"
        Topmost="True"
        Cursor="Cross"
        KeyDown="Window_KeyDown"
        SourceInitialized="Window_SourceInitialized">

    <Grid>
        <Canvas x:Name="SelectionCanvas"
                Background="Transparent"
                MouseLeftButtonDown="SelectionCanvas_MouseLeftButtonDown"
                MouseMove="SelectionCanvas_MouseMove"
                MouseLeftButtonUp="SelectionCanvas_MouseLeftButtonUp">
            <Border x:Name="SelectionBorder"
                    Visibility="Collapsed"
                    BorderBrush="#2CC7F5"
                    BorderThickness="3"
                    Background="#2200A6FF">
                <Border.Effect>
                    <DropShadowEffect Color="#159CFF" BlurRadius="18" ShadowDepth="0" Opacity="0.8"/>
                </Border.Effect>
            </Border>
        </Canvas>

        <Border VerticalAlignment="Top" HorizontalAlignment="Center"
                Margin="0,26,0,0" Padding="20,12"
                Background="#E60A1423" BorderBrush="#365574"
                BorderThickness="1" CornerRadius="14">
            <StackPanel>
                <TextBlock Text="เลือกพื้นที่ที่จะบันทึก"
                           Foreground="White" FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="InstructionText"
                           Text="ลากเมาส์ครอบพื้นที่ที่ต้องการ · ENTER ยืนยัน · ESC ยกเลิก"
                           Margin="0,5,0,0" Foreground="#9CB3D2" FontSize="11"/>
            </StackPanel>
        </Border>

        <Border x:Name="SelectionInfoPanel"
                Visibility="Collapsed"
                VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="0,0,0,30" Padding="18,12"
                Background="#F20A1423" BorderBrush="#2CC7F5"
                BorderThickness="1" CornerRadius="14">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="SelectionSizeText"
                           Foreground="White" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,18,0"/>
                <Button Content="ยืนยัน"
                        Click="Confirm_Click"
                        Padding="20,8" Foreground="White"
                        Background="#126CFF" BorderThickness="0" Cursor="Hand"/>
                <Button Content="เลือกใหม่"
                        Click="Reset_Click"
                        Padding="16,8" Margin="8,0,0,0"
                        Foreground="#D7E7FA" Background="#20324A"
                        BorderBrush="#35506E" BorderThickness="1" Cursor="Hand"/>
                <Button Content="ยกเลิก"
                        Click="Cancel_Click"
                        Padding="16,8" Margin="8,0,0,0"
                        Foreground="#D7E7FA" Background="#20324A"
                        BorderBrush="#35506E" BorderThickness="1" Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
